[Unit]
Description=kole backend (FastAPI: Kokoro TTS + OpenPronounce scoring)
After=network.target

[Service]
WorkingDirectory=%h/gh/kole/backend
Environment=HF_HUB_OFFLINE=1
Environment=KOLE_TORCH_THREADS=6
# Optional: KOLE_PASSWORD=... and other settings, kept out of git.
EnvironmentFile=-%h/.config/kole/env
ExecStart=%h/gh/kole/backend/.venv/bin/uvicorn kole.app:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure

[Install]
WantedBy=default.target
